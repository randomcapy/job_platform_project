# Copy this file to .env and customise as needed.
# All values below are the defaults — only set what you want to change.

# APP
APP_TITLE=ResumeMatch AI
DEBUG=true

# DATABASE (default: SQLite file in the backend directory)
DATABASE_URL=sqlite:///./job_platform.db

# AI MODEL — change this to a larger model for better accuracy
# Options: all-MiniLM-L6-v2 (fast), all-mpnet-base-v2 (accurate), multi-qa-mpnet-base-dot-v1
SBERT_MODEL_NAME=all-MiniLM-L6-v2

# MATCHING
# Cosine similarity threshold — jobs below this score are considered poor matches
# 0.35 = permissive, 0.5 = moderate, 0.65 = strict
SIMILARITY_THRESHOLD=0.35

# Maximum number of match results to return per query
MAX_RESULTS=10

# FILE UPLOAD
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
